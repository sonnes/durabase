{
  "name": "durabase-test",
  "main": "./worker.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "DB", "class_name": "Database" },
      { "name": "MAILBOX", "class_name": "Mailbox" },
      { "name": "AUTH", "class_name": "Auth" },
      { "name": "FILES", "class_name": "Files" }
    ]
  },
  "r2_buckets": [
    { "binding": "MAILBOX_FILES", "bucket_name": "mailbox-files" },
    { "binding": "FILES_BUCKET", "bucket_name": "files" }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Database"] },
    { "tag": "v2", "new_sqlite_classes": ["Mailbox"] },
    { "tag": "v3", "new_sqlite_classes": ["Auth"] },
    { "tag": "v4", "new_sqlite_classes": ["Files"] }
  ],
  "ratelimits": [{ "name": "DURABASE_LIMIT", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } }],
  "vars": { "DURABASE_AUTH_SECRET": "test-secret-of-32-characters-or-more" }
}
