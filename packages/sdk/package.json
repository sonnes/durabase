{
  "name": "@durabase/sdk",
  "version": "0.0.1",
  "type": "module",
  "description": "A typed database and mailbox for Cloudflare Workers, built from your SQL schema. Like Supabase, but on Cloudflare.",
  "license": "MIT",
  "author": "Ravi Atluri",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sonnes/durabase.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/sonnes/durabase#readme",
  "bugs": "https://github.com/sonnes/durabase/issues",
  "keywords": [
    "cloudflare",
    "durable-objects",
    "sqlite",
    "workers",
    "supabase",
    "json-rpc",
    "email"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "bin": {
    "durabase": "./bin/durabase.js"
  },
  "files": [
    "src",
    "bin",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "cp ../../README.md README.md"
  },
  "dependencies": {
    "postal-mime": "^4.2.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@cloudflare/workers-types": "^5.20261019.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
